//===----------------------------------------------------------------------===//
//
// Instruction-to-scheduling-class mappings for the TMP94C241 model.
//
// This file is included after TLCS900InstrInfo.td so that instruction
// definitions are visible. The SchedWrite/SchedRead types and the
// TMP94C241Model are defined in TLCS900Schedule.td.
//
// The CompleteModel=0 setting allows any instruction not listed here to
// use a default 1-cycle model, so only instructions with non-trivial
// timing need explicit mappings. The ~600 assembler-only extended
// addressing mode instructions (ERP, SPI, SRI, PB, etc.) are left to
// the default since they are not generated by the compiler.
//
//===----------------------------------------------------------------------===//

let SchedModel = TMP94C241Model in {

//--- Register-register ALU (1 cycle) ---
def : InstRW<[WriteIALU],
  (instrs
    // 32-bit reg-reg ALU
    ADD32rr, SUB32rr, AND32rr, OR32rr, XOR32rr, CP32rr,
    ADC32rr, SBC32rr, LD32rr,
    // 16-bit reg-reg ALU
    ADD16rr, SUB16rr, AND16rr, OR16rr, XOR16rr, CP16rr,
    ADC16rr, SBC16rr,
    // 8-bit reg-reg ALU
    ADD8rr, SUB8rr, AND8rr, OR8rr, XOR8rr, CP8rr,
    ADC8rr, SBC8rr,
    // Unary register operations
    CPL32, CPL16, CPL8, NEG32, NEG16, NEG8, DAA32,
    EXTS32, EXTS16, EXTS8, EXTZ32, EXTZ16, EXTZ8,
    // Small immediate compare
    CP32_small, CP16_small, CP8_small,
    // Bit operations (register)
    BIT32, BIT16, BIT8, SET32, SET16, SET8, RES32, RES16, RES8,
    CHG32, CHG16,
    // TSET (register)
    TSET32,
    // Bit search
    BS1B16, BS1B8,
    // Condition code set
    SCC32, SCC16, SCC8,
    // INC/DEC (register)
    INC32, INC16, INC8, DEC32, DEC16, DEC8
  )>;

//--- Register-immediate ALU (2 cycles) ---
def : InstRW<[WriteIALUImm],
  (instrs
    // 32-bit reg-imm ALU
    ADD32ri, SUB32ri, AND32ri, OR32ri, XOR32ri, CP32ri,
    ADC32ri, SBC32ri, LD32ri,
    // 16-bit reg-imm ALU
    ADD16ri, SUB16ri, AND16ri, OR16ri, XOR16ri, CP16ri,
    ADC16ri, SBC16ri,
    // 8-bit reg-imm ALU
    ADD8ri, SUB8ri, AND8ri, OR8ri, XOR8ri, CP8ri,
    ADC8ri, SBC8ri,
    // Short/small immediates
    LD32ri_small, LD16ri_small, LD16ri_short,
    LD8ri_small, LD8ri_short
  )>;

//--- Memory loads (register indirect, 3 cycles) ---
def : InstRW<[WriteLDW],
  (instrs
    LD32rm, LD16rm, LD8rm,
    // Assembler-only LD variants
    LD16rm_asm, LD8rm_asm
  )>;

//--- Memory stores (register indirect, 3 cycles) ---
def : InstRW<[WriteSTW],
  (instrs
    LD32mr, LD16mr, LD8mr,
    LD32mr_src, LD16mr_src, LD8mr_src,
    // Assembler-only variants
    LD16mr_asm, LD8mr_asm
  )>;

//--- Memory stores with immediate (4 cycles) ---
def : InstRW<[WriteSTImm],
  (instrs
    LD32mi, LD8mi_dst, LD16mi_dst, LD16mi_dst_02, LD16mi_dst_16,
    // I/O stores
    LDIO, LDWIO
  )>;

//--- Memory ALU (read-modify-write, 5 cycles) ---
def : InstRW<[WriteMemALU],
  (instrs
    ADD32mr, SUB32mr, AND32mr, OR32mr, XOR32mr, CP32mr, CP32mi,
    ADC32mr, SBC32mr, ADC32rm, SBC32rm, ADD32rm, SUB32rm, AND32rm,
    OR32rm, XOR32rm, CP32rm,
    ADD16mr, SUB16mr, AND16mr, OR16mr, XOR16mr, CP16mr,
    ADC16mr, SBC16mr, ADC16rm, SBC16rm, ADD16rm, SUB16rm,
    AND16rm, OR16rm, XOR16rm, CP16rm,
    ADD16mi, SUB16mi, AND16mi, OR16mi, XOR16mi,
    ADC16mi, SBC16mi,
    ADD8mr, SUB8mr, AND8mr, OR8mr, XOR8mr, CP8mr,
    ADC8mr, SBC8mr, ADC8rm, SBC8rm, ADD8rm, SUB8rm,
    AND8rm, OR8rm, XOR8rm, CP8rm,
    ADD8mi, SUB8mi, AND8mi, OR8mi, XOR8mi,
    ADC8mi, SBC8mi,
    // Memory INC/DEC
    INC8m, DEC8m, INC16m, DEC16m,
    // Memory bit operations
    BITm, SETm, RESm, CHGm, TSETm,
    // Memory CF operations
    LDCFm, STCFm,
    // Memory compare with immediate
    CP8mi, CP16mi
  )>;

//--- Shift/rotate by immediate (4 cycles typical for 1-bit) ---
def : InstRW<[WriteShift],
  (instrs
    SLA32ri, SLA16ri, SLA8ri,
    SLL32ri, SLL16ri, SLL8ri,
    SRA32ri, SRA16ri, SRA8ri,
    SRL32ri, SRL16ri, SRL8ri,
    // Shift-by-1 (A variants)
    SLA_A_32, SLA_A_16, SLA_A_8,
    SLL_A_32, SLL_A_16, SLL_A_8,
    SRA_A_32, SRA_A_16, SRA_A_8,
    SRL_A_32, SRL_A_16, SRL_A_8,
    // Rotate operations
    RLC32, RLC16, RLC8, RRC32, RRC16, RRC8,
    RL32, RL16, RL8, RR32, RR16, RR8,
    RLC_I_32, RLC_I_16, RLC_I_8, RRC_I_32, RRC_I_16, RRC_I_8
  )>;

//--- Shift by register (variable, 8 cycles estimate) ---
def : InstRW<[WriteShiftVar],
  (instrs SLA32rr, SRA32rr, SRL32rr)>;

//--- Multiply (14 cycles) ---
def : InstRW<[WriteIMul],
  (instrs
    MUL16rr, MULS16rr,
    MUL8ri, MULS8ri, MUL16ri, MULS16ri,
    MUL8rr, MULS8rr
  )>;

//--- Divide (18 cycles) ---
def : InstRW<[WriteIDiv],
  (instrs
    DIV16rr, DIVS16rr,
    DIV8ri, DIVS8ri, DIV16ri, DIVS16ri,
    DIV8rr, DIVS8rr
  )>;

//--- Unconditional jumps (4 cycles) ---
def : InstRW<[WriteJmp],
  (instrs JP, JP16, JP_r, JR, JRL)>;

//--- Conditional branches (3 cycles average) ---
def : InstRW<[WriteJmpCond],
  (instrs JPcc, JRcc, JRLcc, RETcc)>;

//--- CALL (6 cycles) ---
def : InstRW<[WriteCall],
  (instrs CALL, CALL16, CALR, CALL_r)>;

//--- RET/RETI/RETD (6 cycles) ---
def : InstRW<[WriteRet],
  (instrs RET, RETI, RETD)>;

//--- PUSH (3-4 cycles) ---
def : InstRW<[WritePush],
  (instrs
    PUSH32, PUSH16, PUSH8,
    PUSH16_short, PUSH_imm8, PUSHW_imm, PUSHW_m,
    PUSH_SR, PUSH_F, PUSH_A
  )>;

//--- POP (3-4 cycles) ---
def : InstRW<[WritePop],
  (instrs
    POP32, POP16, POP8,
    POP16_short,
    POP_SR, POP_F, POP_A
  )>;

//--- DJNZ (6 cycles) ---
def : InstRW<[WriteDJNZ],
  (instrs DJNZ32, DJNZ16, DJNZ8)>;

//--- Block transfers (variable, high latency) ---
def : InstRW<[WriteBlkXfer],
  (instrs
    LDIR, LDDR, LDIR85, LDDR85, LDIR83, LDDR83,
    LDI, LDD, LDI85, LDIRW, LDIRW93, LDIW
  )>;

//--- Block search (variable, high latency) ---
def : InstRW<[WriteBlkSearch],
  (instrs CPI, CPD, CPIR, CPDR)>;

//--- Exchange (2 cycles) ---
def : InstRW<[WriteExchange],
  (instrs EX32, EX16, EX8, EX_FF)>;

//--- LDA (2 cycles) ---
def : InstRW<[WriteLDA], (instrs LDA32)>;

//--- LINK/UNLK (6 cycles) ---
def : InstRW<[WriteLinkUnlk],
  (instrs LINK, LINK32, UNLK, UNLK32)>;

//--- Flag manipulation (1 cycle) ---
def : InstRW<[WriteFlagOp],
  (instrs SCF, CCF, ZCF, RCF, INCF, DECF,
    LDCF8ri, LDCF16ri, STCF8ri, STCF16ri)>;

//--- LDC (control register, 2 cycles) ---
def : InstRW<[WriteLDC],
  (instrs LDC_8_CR, LDC_16_CR, LDC_32_CR,
    LDC_CR8, LDC_CR16, LDC_CR32)>;

//--- NOP/system (1 cycle) ---
def : InstRW<[WriteNop],
  (instrs NOP, HALT, EI, LDF, SWI, NORMAL)>;

//--- Direct addressing (4 cycles) ---
def : InstRW<[WriteDirect],
  (instrs
    // Direct address loads
    LD8_da16, LD8_da24, LD16_da16, LD16_da24, LD32_da16, LD32_da24,
    LD8_da16_r8, LD8_da24_r8, LD16_da16_r16, LD16_da24_r16,
    // Direct address stores
    LD8m_da16, LD8m_da24, LD16m_da16, LD16m_da24, LD32m_da16, LD32m_da24,
    LD8m_da16_r8, LD8m_da24_r8, LD16m_da16_r16, LD16m_da24_r16,
    // Direct address stores with immediate
    LD8mi_da16, LD8mi_da24, LD16mi_da16, LD16mi_da24,
    // Direct address ALU
    ADD8_da16, ADD8_da24, SUB8_da16, SUB8_da24,
    AND8_da16, AND8_da24, OR8_da16, OR8_da24, XOR8_da16, XOR8_da24,
    CP8_da16, CP8_da24,
    ADD8_da16_r8, SUB8_da16_r8,
    AND8_da16_r8, OR8_da16_r8,
    XOR8_da16_r8, CP8_da16_r8,
    ADD8m_da16, ADD8m_da24, SUB8m_da16, SUB8m_da24,
    AND8m_da16, AND8m_da24, OR8m_da16, OR8m_da24,
    XOR8m_da16, XOR8m_da24, CP8m_da16, CP8m_da24,
    ADD8m_da16_r8, SUB8m_da16_r8,
    AND8m_da16_r8, OR8m_da16_r8,
    XOR8m_da16_r8, CP8m_da16_r8,
    ADD8i_da16, ADD8i_da24, SUB8i_da16, SUB8i_da24,
    AND8i_da16, AND8i_da24, OR8i_da16, OR8i_da24,
    XOR8i_da16, XOR8i_da24, CP8i_da16, CP8i_da24,
    ADD16_da16, ADD16_da24, SUB16_da16, SUB16_da24,
    AND16_da16, AND16_da24, OR16_da16, OR16_da24,
    CP16_da16, CP16_da24,
    ADD16_da24_r16, SUB16_da24_r16,
    AND16_da24_r16, OR16_da24_r16, XOR16_da24_r16,
    CP16_da24_r16,
    ADD16m_da16, ADD16m_da24, SUB16m_da16, SUB16m_da24,
    AND16m_da16, AND16m_da24, OR16m_da16, OR16m_da24,
    XOR16m_da16, XOR16m_da24, CP16m_da16, CP16m_da24,
    ADD16m_da24_r16, SUB16m_da24_r16,
    AND16m_da24_r16, OR16m_da24_r16, XOR16m_da24_r16,
    CP16m_da24_r16,
    ADD16i_da16, ADD16i_da24, SUB16i_da16, SUB16i_da24,
    AND16i_da16, AND16i_da24, OR16i_da16, OR16i_da24,
    CP16i_da16, CP16i_da24,
    ADD32_da16, ADD32_da24, SUB32_da16, SUB32_da24,
    ADD32m_da16, ADD32m_da24, SUB32m_da16, SUB32m_da24,
    AND32_da24, AND32m_da24, OR32_da24, OR32m_da24,
    CP32_da16, CP32_da24, CP32m_da16, CP32m_da24,
    // Direct address bit/flag ops
    BIT_da16, BIT_da24, SET_da16, SET_da24, RES_da16, RES_da24,
    CHG_da24, TSET_da16, TSET_da24,
    // Direct address INC/DEC
    INC8_da16, INC8_da24, DEC8_da16, DEC8_da24,
    INC16_da16, INC16_da24, DEC16_da16, DEC16_da24,
    INC8_dda16, INC8_dda24, DEC8_dda16, DEC8_dda24,
    INC16_dda16, INC16_dda24, DEC16_dda16, DEC16_dda24,
    // Direct address ADC/SBC
    ADC8_da24, SBC8_da24, ADC8i_da24, SBC8i_da24,
    // Direct address PUSH
    PUSH_da24
  )>;

} // SchedModel = TMP94C241Model
